# Default Deny:
*

# Allow List:
!.gitignore
!.golangci.yml
!wip/examples/clients/web/frontend/**/*.js
!wip/examples/clients/web/frontend/**/*.html
!wip/examples/clients/web/frontend/**/*.css
!wip/examples/clients/web/**/*.md
!go.mod
!go.sum
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE
!README.md
!docs/**/*.md
!*.go
!**/testdata/*.json
!**/testdata/*.yaml
!**/testdata/*.csv

# Allow above in all subdirectories:
!*/

# Exceptions for allowed files:
vendor/
**/.gitignore
**/.golangci.yml
